CONFERENCE_PORT=8080

# Web App publicado a partir de google_apps_script/Code.gs
APPS_SCRIPT_URL=
# Gere um valor longo e aleatorio; use o mesmo em Script Properties no Apps Script.
SYNC_SHARED_SECRET=

# Agendamento e resiliencia do backend (o navegador nao executa o agendamento).
SYNC_INTERVAL_MINUTES=30
SYNC_BATCH_SIZE=10
SYNC_MAX_RETRIES=3
SYNC_RETRY_DELAY=2
SYNC_CONNECT_TIMEOUT=5
SYNC_READ_TIMEOUT=30
SYNC_RESERVATION_TIMEOUT_MINUTES=15
